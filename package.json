{
  "name": "anki-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Anki-style interval repetition flashcard PWA",
  "type": "module",
  "scripts": {
    "test": "node test.cjs && npm run lint",
    "test:unit": "node test.cjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint app.css",
    "lint:html": "htmlhint index.html"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "htmlhint": "^1.1.4",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
